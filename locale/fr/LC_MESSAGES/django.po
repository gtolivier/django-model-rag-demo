#: pages/templates/pages/chat.html:3 pages/templates/pages/chat.html:5
#: pages/templates/pages/nav.html:5
msgid "Ask a question"
msgstr "Poser une question"

#: pages/templates/pages/chat.html:6
msgid ""
"The answers come from the shop's own pages, cheeses and articles. With “Keep "
"the earlier exchanges in context” checked, the assistant also reads your "
"last five exchanges, so you can ask a follow-up question; unchecked, each "
"question is answered on its own."
msgstr ""
"Les réponses viennent des pages, des fromages et des articles de la "
"boutique. Avec « Garder les échanges précédents dans le contexte » coché, "
"l'assistant lit aussi vos cinq derniers échanges : vous pouvez poser une "
"question qui prolonge la précédente. Décoché, chaque question est traitée "
"séparément."

#: pages/templates/pages/chat.html:27
msgid "Your question"
msgstr "Votre question"

#: pages/templates/pages/chat.html:29
msgid "Keep the earlier exchanges in context"
msgstr "Garder les échanges précédents dans le contexte"

#: pages/templates/pages/chat.html:30
msgid "Looking for an answer…"
msgstr "Recherche d'une réponse…"

#: pages/templates/pages/chat.html:30
msgid "Ask"
msgstr "Demander"

#: pages/templates/pages/chat_exchange.html:3
#, python-format
